<!--
    WPF ControlTemplate and Style triggers:
      Microsoft Docs — ControlTemplate:
      https://learn.microsoft.com/en-us/dotnet/api/system.windows.controls.controltemplate
    
    WrapPanel for responsive chip layout:
      Microsoft Docs — WrapPanel:
      https://learn.microsoft.com/en-us/dotnet/api/system.windows.controls.wrappanel
-->

<Window x:Class="Cyber_Security_Awareness_Chatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberGuard Awareness Assistant"
        Height="780" Width="980"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E1A">

    <Window.Resources>
        <!-- Colour palette -->
        <SolidColorBrush x:Key="BgDeep"       Color="#0A0E1A"/>
        <SolidColorBrush x:Key="BgPanel"      Color="#0F1526"/>
        <SolidColorBrush x:Key="BgCard"       Color="#141B2D"/>
        <SolidColorBrush x:Key="AccentCyan"   Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentGreen"  Color="#39FF14"/>
        <SolidColorBrush x:Key="AccentAmber"  Color="#FFB300"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#E8F4FD"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#5A7A99"/>
        <SolidColorBrush x:Key="BotBubble"    Color="#162032"/>
        <SolidColorBrush x:Key="UserBubble"   Color="#0D2B1A"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#1E2D45"/>

        <!-- Input TextBox style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F1526"/>
            <Setter Property="Foreground" Value="#E8F4FD"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#1E2D45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action button style (cyan, used for Send / Add / Start / Submit etc.) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00E5FF"/>
            <Setter Property="Foreground" Value="#0A0E1A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33EEFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00B8CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary / danger button (amber) e.g. Delete -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FFB300"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC94D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quick-topic chip button style -->
        <Style x:Key="ChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#141B2D"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="BorderBrush" Value="#1E2D45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,3"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E2D45"/>
                                <Setter Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiz option button -->
        <Style x:Key="QuizOptionStyle" TargetType="Button">
            <Setter Property="Background" Value="#141B2D"/>
            <Setter Property="Foreground" Value="#E8F4FD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="BorderBrush" Value="#1E2D45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E2D45"/>
                                <Setter Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab item style -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#5A7A99"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Bd" Background="#0F1526" BorderBrush="#1E2D45" BorderThickness="0,0,1,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141B2D"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Tabbed content -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ HEADER ═══════════════ -->
        <Border Grid.Row="0" Background="#0F1526" BorderBrush="#1E2D45" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CYBERGUARD" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                        <TextBlock Text="Awareness Assistant" FontFamily="Consolas" FontSize="10" Foreground="#5A7A99"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#39FF14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLabel" Text="ONLINE" FontFamily="Consolas" FontSize="11" Foreground="#39FF14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DbStatusLabel" Text="  •  DB: checking..." FontFamily="Consolas" FontSize="11" Foreground="#5A7A99" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ TAB CONTROL ═══════════════ -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" Background="#0A0E1A" BorderThickness="0">

            <!-- ───────── CHAT TAB ───────── -->
            <TabItem Header="💬 CHAT" Style="{StaticResource DarkTabItem}">
                <Grid Background="#0A0E1A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,8">
                            <StackPanel x:Name="ChatPanel" Margin="0,8"/>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="1" Background="#0F1526" BorderBrush="#1E2D45" BorderThickness="0,1,0,0" Padding="16,8">
                        <StackPanel>
                            <TextBlock Text="QUICK TOPICS" FontFamily="Consolas" FontSize="9" Foreground="#5A7A99" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <Button Style="{StaticResource ChipStyle}" Content="🔑 Passwords" Click="QuickTopic_Click" Tag="Tell me about password safety"/>
                                <Button Style="{StaticResource ChipStyle}" Content="🎣 Phishing" Click="QuickTopic_Click" Tag="Tell me about phishing"/>
                                <Button Style="{StaticResource ChipStyle}" Content="🔒 Privacy" Click="QuickTopic_Click" Tag="Tell me about privacy"/>
                                <Button Style="{StaticResource ChipStyle}" Content="📶 Wi-Fi" Click="QuickTopic_Click" Tag="Tell me about wifi safety"/>
                                <Button Style="{StaticResource ChipStyle}" Content="🔐 MFA" Click="QuickTopic_Click" Tag="Tell me about MFA"/>
                                <Button Style="{StaticResource ChipStyle}" Content="🎯 Quiz" Click="QuickTopic_Click" Tag="start quiz"/>
                                <Button Style="{StaticResource ChipStyle}" Content="📋 My Tasks" Click="QuickTopic_Click" Tag="show tasks"/>
                                <Button Style="{StaticResource ChipStyle}" Content="🧠 Activity Log" Click="QuickTopic_Click" Tag="show activity log"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="#0F1526" BorderBrush="#1E2D45" BorderThickness="0,1,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputBox" Grid.Column="0" Style="{StaticResource InputStyle}" KeyDown="InputBox_KeyDown" Margin="0,0,10,0" Height="42"/>
                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="SEND ▶" Height="42" Margin="0" Click="SendButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ───────── TASKS TAB ───────── -->
            <TabItem Header="📋 TASKS" Style="{StaticResource DarkTabItem}">
                <Grid Background="#0A0E1A" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Add task form -->
                    <Border Grid.Row="0" Background="#141B2D" BorderBrush="#1E2D45" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ADD NEW TASK" FontFamily="Consolas" FontSize="11" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox x:Name="TaskTitleBox" Style="{StaticResource InputStyle}" Margin="0,0,0,8" Tag="Task title (e.g. Enable 2FA)"/>
                            <TextBox x:Name="TaskDescBox" Style="{StaticResource InputStyle}" Margin="0,0,0,8" Tag="Description"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TaskReminderBox" Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,10,0" Tag="Reminder (e.g. in 3 days / tomorrow) - optional"/>
                                <Button x:Name="AddTaskButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="ADD TASK" Margin="0" Click="AddTaskButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Task list -->
                    <Border Grid.Row="1" Background="#0F1526" BorderBrush="#1E2D45" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox x:Name="TasksListBox" Background="Transparent" BorderThickness="0" Foreground="#E8F4FD" FontFamily="Consolas" FontSize="13"/>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource ActionButtonStyle}" Content="✅ MARK COMPLETE" Click="CompleteTaskButton_Click"/>
                        <Button Style="{StaticResource DangerButtonStyle}" Content="🗑 DELETE" Click="DeleteTaskButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="🔄 REFRESH" Margin="0" Click="RefreshTasksButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ───────── QUIZ TAB ───────── -->
            <TabItem Header="🎯 QUIZ" Style="{StaticResource DarkTabItem}">
                <Grid Background="#0A0E1A" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="StartQuizButton" Style="{StaticResource ActionButtonStyle}" Content="▶ START NEW QUIZ" Click="StartQuizButton_Click"/>
                        <TextBlock x:Name="QuizProgressLabel" Text="" Foreground="#5A7A99" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#141B2D" BorderBrush="#1E2D45" BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="QuizQuestionText" Text="Press 'START NEW QUIZ' to begin testing your cybersecurity knowledge!"
                                       FontFamily="Consolas" FontSize="15" Foreground="#E8F4FD" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <StackPanel x:Name="QuizOptionsPanel"/>
                            <TextBlock x:Name="QuizFeedbackText" Text="" FontFamily="Consolas" FontSize="13" Foreground="#39FF14" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="QuizScoreLabel" Text="" Foreground="#00E5FF" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Margin="0,12,0,0"/>
                </Grid>
            </TabItem>

            <!-- ───────── ACTIVITY LOG TAB ───────── -->
            <TabItem Header="🧠 LOG" Style="{StaticResource DarkTabItem}">
                <Grid Background="#0A0E1A" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0F1526" BorderBrush="#1E2D45" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox x:Name="ActivityLogListBox" Background="Transparent" BorderThickness="0" Foreground="#E8F4FD" FontFamily="Consolas" FontSize="13"/>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="ShowMoreLogButton" Style="{StaticResource ActionButtonStyle}" Content="⬇ SHOW MORE" Click="ShowMoreLogButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="🔄 REFRESH" Margin="0" Click="RefreshLogButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══════════════ STATUS BAR ═══════════════ -->
        <Border Grid.Row="2" Background="#080C18" BorderBrush="#1E2D45" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintLabel" Grid.Column="0"
                           Text="Type naturally — e.g. 'remind me to update my password tomorrow' or 'start quiz'  •  Tabs above for direct access"
                           FontFamily="Consolas" FontSize="10" Foreground="#3A5A75" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="South African Dept. of Cybersecurity" FontFamily="Consolas" FontSize="10" Foreground="#3A5A75" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
